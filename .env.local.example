# Copy to .env.local and fill in. Never commit .env.local.

# Adzuna public job API (free registration: https://developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Shared secret for POST /api/ingest/email (generate with: openssl rand -hex 24)
INGEST_SECRET=

# Optional: protects GET/POST /api/cron/refresh on hosted deployments (e.g. Vercel Cron)
CRON_SECRET=

# Open-web search (free plan: 1,000 credits/month): https://app.tavily.com
TAVILY_API_KEY=

# Optional password for the whole dashboard (any username, this password). Set it before the app
# is reachable from anywhere but this Mac: phone on Wi-Fi, a tunnel, a deploy.
DASHBOARD_PASSWORD=

# Hosted database (required on Vercel; optional locally, where the default is data/dashboard.db).
# Create one with the Turso CLI, see README -> "Deploying to Vercel".
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Notion notes sync (read-only integration token from notion.so/my-integrations)
NOTION_TOKEN=
